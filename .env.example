# Oddsmaker 快速启动环境配置（全部中文注释）
# 用法：cp .env.example .env 然后按需修改
# docker compose -f docker-compose.quickstart.yml up -d

# ============================================================
# 端口映射（宿主端口：容器端口）——默认用 3xxxx 组避开本机常用端口冲突
# ============================================================

# PostgreSQL 宿主端口（容器内固定 5432）
POSTGRES_PORT=35432

# Redis 宿主端口（容器内固定 6379）
REDIS_PORT=36379

# Kafka 宿主端口（容器内固定 9092；PLAINTEXT_HOST 另开 29092 供宿主直连）
KAFKA_PORT=39092

# ClickHouse HTTP 接口宿主端口（容器内固定 8123）
CLICKHOUSE_HTTP_PORT=38123

# ClickHouse Native 接口宿主端口（容器内固定 9000）
CLICKHOUSE_NATIVE_PORT=39000

# Apicurio Schema Registry 宿主端口（容器内固定 8080）
APICURIO_PORT=38081

# Control Service 宿主端口（容器内固定 8085，actuator 同端口）
CONTROL_PORT=38085

# Gateway Service 宿主端口（容器内固定 8080）
GATEWAY_PORT=38080

# Superset 宿主端口（容器内固定 8088，可选）
SUPERSET_PORT=38088

# ============================================================
# 数据库/中间件 凭据（按需改，生产必须改）
# ============================================================

# PostgreSQL 用户/密码/库名
POSTGRES_USER=oddsmaker
POSTGRES_PASSWORD=oddsmaker
# POSTGRES_DB=oddsmaker  # 固定 oddsmaker，由 Flyway 管理 schema

# Redis 密码（留空=无密码）
# REDIS_PASSWORD=

# ClickHouse 用户/密码
CLICKHOUSE_USER=oddsmaker
CLICKHOUSE_PASSWORD=oddsmaker

# ============================================================
# Oddsmaker 业务 Token / 密钥（生产必须替换为强随机值）
# ============================================================

# Control 管理面 Token（用于控制台调用管理类 API）
ODDSMAKER_ADMIN_TOKEN=dev-admin-token

# Control ↔ Gateway 内部通信 Token（两服务间互信）
ODDSMAKER_INTERNAL_TOKEN=dev-internal-token

# Gateway 开发环境默认 API Key 密钥（SDK 接入用，生产请在控制台配置正式 Key）
ODDSMAKER_AUTH_KEYS_DEVKEY=dev-secret

# ============================================================
# 镜像选择（默认拉 nightly；本地构建时改为 local 或留空触发 build）
# ============================================================

# ODDSMAKER_IMAGE=ghcr.io/cuihairu/oddsmaker:nightly
# 本地构建后想用本地镜像时：ODDSMAKER_IMAGE=ghcr.io/cuihairu/oddsmaker:local

# ============================================================
# 可选：Superset 密钥（生产请替换）
# ============================================================

SUPERSET_SECRET_KEY=superset-secret-key-change-in-production