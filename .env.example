# Oddsmaker 快速启动环境变量配置
# 用法：cp .env.example .env 并按需修改
# 所有端口采用 3xxxx 组，避开本机常用端口冲突

# ─────────────────────────────────────────────────────────────
# PostgreSQL（Control 服务的元数据存储，Flyway 自动迁移）
# ─────────────────────────────────────────────────────────────
POSTGRES_USER=oddsmaker
POSTGRES_PASSWORD=oddsmaker
POSTGRES_PORT=35432          # 宿主映射端口（容器内固定 5432）

# ─────────────────────────────────────────────────────────────
# Redis（会话/实时计数/风控短窗状态）
# ─────────────────────────────────────────────────────────────
REDIS_PORT=36379             # 宿主映射端口（容器内固定 6379）

# ─────────────────────────────────────────────────────────────
# Kafka（KRaft 单节点；PLAINTEXT_HOST 供宿主脚本直连调试）
# ─────────────────────────────────────────────────────────────
KAFKA_PORT=39092             # 宿主映射端口（容器内固定 9092）

# ─────────────────────────────────────────────────────────────
# ClickHouse（事件与聚合存储，initdb 仅首跑空卷时执行）
# ─────────────────────────────────────────────────────────────
CLICKHOUSE_USER=oddsmaker
CLICKHOUSE_PASSWORD=oddsmaker
CLICKHOUSE_HTTP_PORT=38123   # HTTP 接口宿主映射端口（容器内 8123）
CLICKHOUSE_NATIVE_PORT=39000 # Native 协议宿主映射端口（容器内 9000）

# ─────────────────────────────────────────────────────────────
# Apicurio Schema Registry（Avro Schema 注册表，Gateway 与 Flink 依赖）
# ─────────────────────────────────────────────────────────────
APICURIO_PORT=38081          # 宿主映射端口（容器内固定 8080）

# ─────────────────────────────────────────────────────────────
# Oddsmaker 镜像与服务端口
# ─────────────────────────────────────────────────────────────
ODDSMAKER_IMAGE=ghcr.io/cuihairu/oddsmaker:nightly
CONTROL_PORT=38085           # Control HTTP/Actuator 宿主映射端口（容器内 8085）
GATEWAY_PORT=38080           # Gateway HTTP/Actuator 宿主映射端口（容器内 8080）

# ─────────────────────────────────────────────────────────────
# 安全 Token（开发环境默认值，生产环境必须替换为强随机串）
# ─────────────────────────────────────────────────────────────
ODDSMAKER_ADMIN_TOKEN=dev-admin-token        # Control 管理 API Bearer Token
ODDSMAKER_INTERNAL_TOKEN=dev-internal-token  # 服务间通信 Token（Gateway→Control 等）
ODDSMAKER_AUTH_KEYS_DEVKEY=dev-secret        # 开发环境 API Key HMAC 密钥

# ─────────────────────────────────────────────────────────────
# 告警邮件通道（可选：不配置则投递自动跳过，告警链路不受影响）
# Control 容器内对应 spring.mail.* 与 oddsmaker.alerts.mail.from
# ─────────────────────────────────────────────────────────────
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=alert@example.com
# SPRING_MAIL_PASSWORD=smtp-password
# ODDSMAKER_ALERTS_MAIL_FROM=alert@example.com

# ─────────────────────────────────────────────────────────────
# Superset（可选看板，需手动初始化管理员后使用）
# ─────────────────────────────────────────────────────────────
SUPERSET_SECRET_KEY=superset-secret-key-change-in-production
SUPERSET_PORT=38088          # 宿主映射端口（容器内固定 8088）