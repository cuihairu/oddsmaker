# Oddsmaker Quickstart 环境变量配置
# 用法：cp .env.example .env && 编辑 .env
# 所有端口默认使用 3xxxx 段，避开本机/ runner 常用端口（5432/6379/9092/8080/8085/28080/28085/28123 等）
# 如有冲突，仅需修改下方对应 PORT 变量即可

# ============================================================
# PostgreSQL（Control Service 元数据存储）
# ============================================================
POSTGRES_PASSWORD=oddsmaker          # 数据库密码
POSTGRES_PORT=35432                  # 宿主映射端口（容器内固定 5432）

# ============================================================
# Redis（实时计数、风控短窗状态、会话缓存）
# ============================================================
REDIS_PORT=36379                     # 宿主映射端口（容器内固定 6379）

# ============================================================
# Kafka（事件总线，KRaft 单节点）
# ============================================================
KAFKA_PORT=39092                     # 宿主映射端口（容器内 PLAINTEXT_HOST 29092，内部 9092）

# ============================================================
# ClickHouse（事件存储与聚合分析）
# ============================================================
CLICKHOUSE_PASSWORD=oddsmaker        # ClickHouse 密码
CLICKHOUSE_HTTP_PORT=38123           # HTTP 接口宿主映射端口（容器内 8123）
CLICKHOUSE_NATIVE_PORT=39000         # Native 协议宿主映射端口（容器内 9000）

# ============================================================
# Apicurio Schema Registry（Avro Schema 管理）
# ============================================================
APICURIO_PORT=38081                  # 宿主映射端口（容器内 8080）

# ============================================================
# Control Service（管理面 API、实验、风控规则、Flyway 迁移）
# ============================================================
CONTROL_PORT=38085                   # 宿主映射端口（容器内 8085，actuator 同端口）
ODDSMAKER_ADMIN_TOKEN=dev-admin-token    # 管理员 Token（生产环境必须改为高强度随机值）
ODDSMAKER_INTERNAL_TOKEN=dev-internal-token  # 服务间通信 Token（生产环境必须改为高强度随机值）

# ============================================================
# Gateway Service（采集入口、Schema 校验、HMAC、限流、前置风控）
# ============================================================
GATEWAY_PORT=38080                   # 宿主映射端口（容器内 8080，actuator 同端口）
ODDSMAKER_AUTH_KEYS_DEVKEY=dev-secret      # 开发环境 HMAC 密钥（生产环境必须改为高强度随机值）

# ============================================================
# Superset（可选看板）
# ============================================================
SUPERSET_PORT=38088                  # 宿主映射端口（容器内 8088；不需要看板可在编排里注释掉该服务）

# ============================================================
# 说明
# ============================================================
# 1. 所有 *_PORT 变量仅控制「宿主机映射端口」，容器内端口由镜像固定（见 docker-compose.quickstart.yml）
# 2. 生产环境部署时，请务必：
#    - 修改所有密码/Token 为高强度随机值
#    - 启用 TLS/HTTPS
#    - 配置防火墙仅允许必要端口
#    - 使用外部托管的 PostgreSQL/Redis/Kafka/ClickHouse
#    - 设置资源限制
# 3. 本文件不包含敏感生产凭据，仅供本地快速体验
# 4. 如需自定义网络/存储/资源限制，请直接编辑 docker-compose.quickstart.yml