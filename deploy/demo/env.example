# Oddsmaker 演示站点环境变量（复制为 .env 放在 compose 同目录）
# 生成随机值：openssl rand -hex 24

# PostgreSQL 口令（control 数据源与 pg 容器共用）
POSTGRES_PASSWORD=change-me

# 管理令牌：X-Admin-Token 头直通 user:update 等管理面（建演示账号用），README 不外传
ODDSMAKER_ADMIN_TOKEN=change-me

# 服务间令牌（演示栈无 gateway，可留空＝/internal/** 拒绝）
ODDSMAKER_INTERNAL_TOKEN=

# 登录 JWT 签名密钥（HS256，>=32 字节，泄漏即登录面失守）
ODDSMAKER_AUTH_JWT_SECRET=change-me-at-least-32-bytes-long-secret

# 镜像 tag（deploy 工作流按 nightly 滚动更新；回滚时也可指 digest）
ODDSMAKER_IMAGE=ghcr.io/cuihairu/oddsmaker:nightly

# control 在宿主的回环端口（nginx 反代目标）
CONTROL_PORT=38085
