# kafka_exporter 自建镜像（供应链治理，替代个人维护者镜像 danielqsj/kafka_exporter）。
#
# 版本冻结在上游 tag v1.7.0（与 infra/docker-compose.yml 引用同一注记），构建参数
# 改版本只动 ARG，不碰 Dockerfile 正文。构建层固定官方 golang:x-alpine digest，
# 运行层固定官方 alpine digest——基础镜像升级是一次显式、可评审的改动。
#
# 版本号经 ldflags 注入 prometheus/common/version（与上游 Makefile/promu 同一
# 变量组），故 `--version` 输出与官方发行二进制一致。
#
# 用法（在 infra/ 目录）：docker compose build kafka-exporter
FROM golang:1.22-alpine@sha256:1699c10032ca2582ec89a24a1312d986a3f094aed3d5c1147b19880afe40e052 AS build

ARG KAFKA_EXPORTER_VERSION=v1.7.0
ARG KAFKA_EXPORTER_COMMIT=7e840e81a0170375214e2c1e1dc7ce94aeff8712

RUN apk add --no-cache git ca-certificates

# 固定 commit SHA 的浅克隆；上游 vendor/ 目录随源码树一并取得，依赖解析离线完成。
# 源码冻结在不可变 commit 而非 tag 名：tag 可被移动/覆盖，commit 不可变，供应链治理才算闭环。
RUN git init /src \
    && cd /src \
    && git remote add origin https://github.com/danielqsj/kafka_exporter.git \
    && git fetch --depth 1 origin "${KAFKA_EXPORTER_COMMIT}" \
    && git checkout --quiet FETCH_HEAD \
    && git submodule update --init --recursive
WORKDIR /src

RUN CGO_ENABLED=0 go build -trimpath \
      -ldflags "-s -w \
        -X github.com/prometheus/common/version.Version=$(cat VERSION | sed 's/^v//') \
        -X github.com/prometheus/common/version.Revision=$(git rev-parse HEAD) \
        -X github.com/prometheus/common/version.Branch=HEAD \
        -X github.com/prometheus/common/version.BuildUser=oddsmaker-infra \
        -X github.com/prometheus/common/version.BuildDate=$(date -u +%Y%m%d-%H:%M:%S)" \
      -o /out/kafka_exporter .

FROM alpine:3.20@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc

# ca-certificates：kafka_exporter --tls.enabled/--server.tls.enabled 需要 CA 证书，alpine 基础镜像默认不含
RUN apk add --no-cache ca-certificates \
    && adduser -D -H -u 9308 exporter

COPY --from=build /out/kafka_exporter /kafka_exporter

USER exporter
EXPOSE 9308

ENTRYPOINT ["/kafka_exporter"]
