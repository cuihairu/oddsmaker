{
  "type": "record",
  "name": "GameEvent",
  "namespace": "io.oddsmaker.v1.game",
  "doc": "Game-specific event schema for Oddsmaker. Extends the base event with game-specific fields and predefined event types.",
  "fields": [
    {"name": "event_id", "type": "string", "doc": "Unique event identifier"},
    {"name": "game_id", "type": "string", "doc": "Game identifier for routing and ClickHouse isolation"},
    {"name": "environment", "type": "string", "doc": "Environment (dev/staging/prod) for routing and ClickHouse isolation"},
    {"name": "event_type", "type": ["null", "string"], "default": null, "doc": "Event type category: session, user, business, resource, progression, design, error, ad, risk, game"},
    {"name": "event_name", "type": "string", "doc": "Specific event name"},
    {"name": "user_id", "type": ["null", "string"], "default": null, "doc": "User account identifier"},
    {"name": "device_id", "type": "string", "doc": "Device identifier"},
    {"name": "player_id", "type": ["null", "string"], "default": null, "doc": "Player identifier (game-specific, may differ from user_id)"},
    {"name": "character_id", "type": ["null", "string"], "default": null, "doc": "Character identifier (for games with multiple characters per account)"},
    {"name": "session_id", "type": ["null", "string"], "default": null, "doc": "Session identifier"},
    {"name": "ts_client", "type": {"type": "long", "logicalType": "timestamp-micros"}, "doc": "Client timestamp (microseconds since epoch)"},
    {"name": "ts_server", "type": ["null", {"type": "long", "logicalType": "timestamp-micros"}], "default": null, "doc": "Server timestamp (microseconds since epoch)"},
    {"name": "platform", "type": ["null", "string"], "default": null, "doc": "Platform: ios, android, web, pc, console"},
    {"name": "app_version", "type": ["null", "string"], "default": null, "doc": "Application version"},
    {"name": "sdk_version", "type": ["null", "string"], "default": null, "doc": "SDK version"},
    {"name": "country", "type": ["null", "string"], "default": null, "doc": "ISO 3166-1 alpha-2 country code"},
    {"name": "client_ip", "type": ["null", "string"], "default": null, "doc": "Client IP address (for geo-location and risk control)"},
    {"name": "user_agent", "type": ["null", "string"], "default": null, "doc": "User agent string"},
    {"name": "server_id", "type": ["null", "string"], "default": null, "doc": "Server/shard identifier (for MMORPG multi-server games)"},
    {"name": "guild_id", "type": ["null", "string"], "default": null, "doc": "Guild/clan identifier"},
    {"name": "match_id", "type": ["null", "string"], "default": null, "doc": "Match/session identifier (for matchmaking games)"},
    {"name": "level_id", "type": ["null", "string"], "default": null, "doc": "Level/stage identifier"},
    {"name": "game_mode", "type": ["null", "string"], "default": null, "doc": "Game mode (pvp, pve, ranked, casual)"},
    {"name": "difficulty", "type": ["null", "string"], "default": null, "doc": "Level or content difficulty"},
    {"name": "progression_path", "type": ["null", "string"], "default": null, "doc": "Optional progression path/chapter"},
    {"name": "order_id", "type": ["null", "string"], "default": null, "doc": "Order/transaction identifier (for revenue events)"},
    {"name": "product_id", "type": ["null", "string"], "default": null, "doc": "Product/Item identifier (for revenue events)"},
    {"name": "revenue_amount", "type": ["null", "double"], "default": null, "doc": "Revenue amount (for revenue events)"},
    {"name": "revenue_currency", "type": ["null", "string"], "default": null, "doc": "Revenue currency (ISO 4217 code)"},
    {"name": "receipt_hash", "type": ["null", "string"], "default": null, "doc": "Payment receipt hash for fraud detection"},
    {"name": "virtual_currency", "type": ["null", "string"], "default": null, "doc": "Virtual currency identifier"},
    {"name": "virtual_amount", "type": ["null", "double"], "default": null, "doc": "Virtual currency amount"},
    {"name": "item_id", "type": ["null", "string"], "default": null, "doc": "Item identifier"},
    {"name": "resource_id", "type": ["null", "string"], "default": null, "doc": "Resource identifier (for resource flow events)"},
    {"name": "resource_amount", "type": ["null", "double"], "default": null, "doc": "Resource amount (for resource flow events)"},
    {"name": "flow_type", "type": ["null", "string"], "default": null, "doc": "Resource flow type: source or sink"},
    {"name": "operation_id", "type": ["null", "string"], "default": null, "doc": "Operation identifier (for linking related resource changes)"},
    {"name": "operation_type", "type": ["null", "string"], "default": null, "doc": "Operation type (e.g., daily_reward, purchase_item)"},
    {"name": "ad_network", "type": ["null", "string"], "default": null, "doc": "Ad network identifier"},
    {"name": "ad_placement", "type": ["null", "string"], "default": null, "doc": "Ad placement identifier"},
    {"name": "ad_format", "type": ["null", "string"], "default": null, "doc": "Ad format: rewarded, interstitial, banner"},
    {"name": "ad_impression_id", "type": ["null", "string"], "default": null, "doc": "Ad impression identifier"},
    {"name": "risk_context", "type": ["null", "string"], "default": null, "doc": "Serialized risk context"},
    {"name": "device_fingerprint", "type": ["null", "string"], "default": null, "doc": "Device fingerprint for risk control"},
    {"name": "client_integrity", "type": ["null", "string"], "default": null, "doc": "Client integrity signal"},
    {"name": "experiments", "type": ["null", {"type": "map", "values": "string"}], "default": null, "doc": "Active experiments and variants"},
    {"name": "event_version", "type": "int", "default": 1, "doc": "Event contract major version (>=1)"},
    {"name": "source", "type": ["null", "string"], "default": null, "doc": "Producer source: client, server, system, derived (gateway-authoritative)"},
    {"name": "trust_level", "type": ["null", "string"], "default": null, "doc": "Trust level derived from source by the gateway: LOW, HIGH, COMPUTED"},
    {"name": "event_origin", "type": ["null", "string"], "default": null, "doc": "SDK name+version for audit (e.g. server-java/0.1.0); gateway fills default when absent"},
    {"name": "props_json", "type": ["null", "string"], "default": null, "doc": "Additional properties as JSON string"},
    
    {"name": "game_event_type", "type": ["null", "string"], "default": null, "doc": "Game event type: level_start, level_complete, level_fail, battle_start, battle_end, quest_accept, quest_complete, achievement_unlock, item_grant, item_consume, currency_source, currency_sink, ad_watch, ad_reward, social_invite, social_accept"},
    {"name": "level_id", "type": ["null", "string"], "default": null, "doc": "Level identifier"},
    {"name": "level_name", "type": ["null", "string"], "default": null, "doc": "Level name"},
    {"name": "level_progress", "type": ["null", "double"], "default": null, "doc": "Level progress (0.0 to 1.0)"},
    {"name": "level_score", "type": ["null", "long"], "default": null, "doc": "Level score"},
    {"name": "level_time_ms", "type": ["null", "long"], "default": null, "doc": "Time spent in level (milliseconds)"},
    {"name": "level_attempts", "type": ["null", "int"], "default": null, "doc": "Number of attempts for the level"},
    
    {"name": "battle_id", "type": ["null", "string"], "default": null, "doc": "Battle/match identifier"},
    {"name": "battle_mode", "type": ["null", "string"], "default": null, "doc": "Battle mode: pvp, pve, ranked, casual, custom"},
    {"name": "battle_result", "type": ["null", "string"], "default": null, "doc": "Battle result: win, lose, draw, abandon"},
    {"name": "battle_duration_ms", "type": ["null", "long"], "default": null, "doc": "Battle duration (milliseconds)"},
    {"name": "battle_rank", "type": ["null", "int"], "default": null, "doc": "Battle rank/position"},
    {"name": "battle_kills", "type": ["null", "int"], "default": null, "doc": "Number of kills in battle"},
    {"name": "battle_deaths", "type": ["null", "int"], "default": null, "doc": "Number of deaths in battle"},
    {"name": "battle_assists", "type": ["null", "int"], "default": null, "doc": "Number of assists in battle"},
    
    {"name": "quest_id", "type": ["null", "string"], "default": null, "doc": "Quest identifier"},
    {"name": "quest_name", "type": ["null", "string"], "default": null, "doc": "Quest name"},
    {"name": "quest_type", "type": ["null", "string"], "default": null, "doc": "Quest type: main, side, daily, weekly, achievement"},
    {"name": "quest_progress", "type": ["null", "double"], "default": null, "doc": "Quest progress (0.0 to 1.0)"},
    {"name": "quest_objective_current", "type": ["null", "int"], "default": null, "doc": "Current objective count"},
    {"name": "quest_objective_target", "type": ["null", "int"], "default": null, "doc": "Target objective count"},
    
    {"name": "achievement_id", "type": ["null", "string"], "default": null, "doc": "Achievement identifier"},
    {"name": "achievement_name", "type": ["null", "string"], "default": null, "doc": "Achievement name"},
    {"name": "achievement_category", "type": ["null", "string"], "default": null, "doc": "Achievement category"},
    {"name": "achievement_points", "type": ["null", "int"], "default": null, "doc": "Achievement points"},
    
    {"name": "item_type", "type": ["null", "string"], "default": null, "doc": "Item type: weapon, armor, consumable, cosmetic, etc."},
    {"name": "item_name", "type": ["null", "string"], "default": null, "doc": "Item name"},
    {"name": "item_rarity", "type": ["null", "string"], "default": null, "doc": "Item rarity: common, uncommon, rare, epic, legendary"},
    {"name": "item_quantity", "type": ["null", "int"], "default": null, "doc": "Item quantity"},
    {"name": "item_level", "type": ["null", "int"], "default": null, "doc": "Item level"},
    
    {"name": "currency_type", "type": ["null", "string"], "default": null, "doc": "Currency type: gold, gems, energy, etc."},
    {"name": "currency_amount", "type": ["null", "double"], "default": null, "doc": "Currency amount"},
    {"name": "currency_balance", "type": ["null", "double"], "default": null, "doc": "Currency balance after transaction"},
    {"name": "currency_source", "type": ["null", "string"], "default": null, "doc": "Currency source: quest, battle, purchase, etc."},
    {"name": "currency_sink", "type": ["null", "string"], "default": null, "doc": "Currency sink: purchase, upgrade, craft, etc."},
    
    {"name": "ad_type", "type": ["null", "string"], "default": null, "doc": "Ad type: rewarded, interstitial, banner, native"},
    {"name": "ad_placement_id", "type": ["null", "string"], "default": null, "doc": "Ad placement identifier"},
    {"name": "ad_reward_type", "type": ["null", "string"], "default": null, "doc": "Ad reward type: currency, item, life, etc."},
    {"name": "ad_reward_amount", "type": ["null", "double"], "default": null, "doc": "Ad reward amount"},
    {"name": "ad_duration_ms", "type": ["null", "long"], "default": null, "doc": "Ad watch duration (milliseconds)"},
    {"name": "ad_completed", "type": ["null", "boolean"], "default": null, "doc": "Whether ad was watched completely"},
    
    {"name": "social_action", "type": ["null", "string"], "default": null, "doc": "Social action: invite, accept, reject, block, etc."},
    {"name": "social_target_user_id", "type": ["null", "string"], "default": null, "doc": "Target user ID for social action"},
    {"name": "social_target_player_id", "type": ["null", "string"], "default": null, "doc": "Target player ID for social action"},
    
    {"name": "error_type", "type": ["null", "string"], "default": null, "doc": "Error type: crash, exception, network, etc."},
    {"name": "error_message", "type": ["null", "string"], "default": null, "doc": "Error message"},
    {"name": "error_stack_trace", "type": ["null", "string"], "default": null, "doc": "Error stack trace"},
    {"name": "error_fatal", "type": ["null", "boolean"], "default": null, "doc": "Whether error was fatal"}
  ]
}