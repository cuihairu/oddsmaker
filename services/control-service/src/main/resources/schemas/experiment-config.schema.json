{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema/json/experiment-config.schema.json",
  "title": "Oddsmaker Experiment Config",
  "type": "object",
  "properties": {
    "variants": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "weight": { "type": "integer", "minimum": 0 }
        },
        "required": ["name"],
        "additionalProperties": true
      }
    },
    "targeting": {
      "type": "object",
      "properties": {
        "platform": { "type": "array", "items": { "type": "string" } },
        "appVersionMin": { "type": "string" },
        "appVersionMax": { "type": "string" },
        "countries": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "metrics": {
      "type": "object",
      "properties": {
        "primary": { "type": "string" },
        "secondary": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "allocation": {
      "type": "object",
      "properties": {
        "strategy": { "type": "string" },
        "weights": { "type": "object" }
      },
      "additionalProperties": true
    },
    "guardrails": {
      "type": "object",
      "properties": {
        "maxExposure": { "type": "integer", "minimum": 0 },
        "minSampleSize": { "type": "integer", "minimum": 0 },
        "stopConditions": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "decision": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["PENDING", "ADOPTED", "REJECTED", "INCONCLUSIVE"] },
        "winner": { "type": "string" },
        "decidedAt": { "type": "string" },
        "reason": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "required": ["variants"],
  "additionalProperties": true
}
